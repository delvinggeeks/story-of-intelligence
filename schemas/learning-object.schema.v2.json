{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-of-intelligence.academy/schemas/learning-object.v2.json",
  "title": "Learning Object Schema v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "scope", "stability", "beginnerEntry", "nextConcept", "knowledge", "learning", "measurement", "reasoning", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^2\\.0\\.0$" },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "stability": { "type": "string", "enum": ["timeless", "mostly-timeless", "stable", "rapidly-evolving"] },
    "beginnerEntry": { "type": "string", "minLength": 1 },
    "nextConcept": { "type": "string" },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["conceptId", "prerequisites", "relatedConcepts", "history", "mentalModels", "analogies"],
      "properties": {
        "conceptId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "relatedConcepts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "history": { "type": "string", "minLength": 40 },
        "mentalModels": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 20 }
            }
          }
        },
        "analogies": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["analogy", "strength", "whenToUse"],
            "properties": {
              "analogy": { "type": "string", "minLength": 1 },
              "strength": { "type": "integer", "minimum": 1, "maximum": 5 },
              "whenToUse": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "learning": {
      "type": "object", "additionalProperties": false,
      "required": ["objectives", "estimatedMinutes", "steps", "experiments"],
      "properties": {
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "steps": {
          "type": "array", "minItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "prompt"],
            "properties": {
              "kind": { "type": "string", "enum": ["observe", "wonder", "predict", "experiment", "fail", "discover", "explain", "visualize", "generalize", "mathematics", "engineer", "optimize", "production", "apply", "reflect", "whats-next"] },
              "prompt": { "type": "string", "minLength": 1 },
              "experimentId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "experiments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "title", "instructions", "config"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "type": { "type": "string", "enum": ["unit-compare", "balance-solve", "function-machine", "vector-drag", "matrix-transform", "dice-histogram", "sampling-mean", "slope-explorer", "gradient-descent", "outlier-fit", "fit-line"] },
              "title": { "type": "string", "minLength": 1 },
              "instructions": { "type": "string", "minLength": 20 },
              "config": { "type": "object" }
            }
          }
        }
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["prePrompt", "postPrompt", "successCriteria", "masteryRubric"],
      "properties": {
        "prePrompt": { "type": "string", "minLength": 1 },
        "postPrompt": { "type": "string", "minLength": 1 },
        "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "masteryRubric": {
          "type": "object", "additionalProperties": false,
          "required": ["threshold", "checks"],
          "properties": {
            "threshold": { "type": "integer", "minimum": 3 },
            "checks": {
              "type": "array", "minItems": 5,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "label", "pattern"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                  "label": { "type": "string", "minLength": 10 },
                  "pattern": { "type": "string", "minLength": 3 }
                }
              }
            }
          }
        }
      }
    },
    "reasoning": {
      "type": "object", "additionalProperties": false,
      "required": ["misconceptions", "tutorGuidance"],
      "properties": {
        "misconceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tutorGuidance": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "validated"] }
      }
    }
  }
}
