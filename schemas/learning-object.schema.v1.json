{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-of-intelligence.academy/schemas/learning-object.v1.json",
  "title": "Learning Object Schema v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "scope", "beginnerEntry", "knowledge", "learning", "measurement", "reasoning", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "beginnerEntry": { "type": "string", "minLength": 1 },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["conceptId", "prerequisites", "relatedConcepts"],
      "properties": {
        "conceptId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "relatedConcepts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "learning": {
      "type": "object", "additionalProperties": false,
      "required": ["objectives", "estimatedMinutes", "steps"],
      "properties": {
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "steps": {
          "type": "array", "minItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "prompt"],
            "properties": {
              "kind": { "type": "string", "enum": ["observe", "wonder", "predict", "explain", "apply"] },
              "prompt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["prePrompt", "postPrompt", "successCriteria"],
      "properties": {
        "prePrompt": { "type": "string", "minLength": 1 },
        "postPrompt": { "type": "string", "minLength": 1 },
        "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reasoning": {
      "type": "object", "additionalProperties": false,
      "required": ["misconceptions", "tutorGuidance"],
      "properties": {
        "misconceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tutorGuidance": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "validated"] }
      }
    }
  }
}
