# Copy to .env in the REPOSITORY ROOT. Never commit a filled-in .env.
# No secrets, API keys, or external provider credentials are required by the current phase.
#
# The API reads .env from the repository root first, then services/api/.env if present.
# Both are resolved as absolute paths, so the working directory does not matter.

# --- services/api ---
ACADEMY_ENVIRONMENT=local
# Absolute, or relative to the repository root (never relative to the working directory).
ACADEMY_CONTENT_ROOT=packages/content
ACADEMY_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# --- apps/web ---
# Next.js loads env files from apps/web, so copy this block to apps/web/.env for local dev.
ACADEMY_API_URL=http://127.0.0.1:8000
# Opt out of Next.js build/dev telemetry. Also enforced by apps/web/scripts/next.mjs.
NEXT_TELEMETRY_DISABLED=1
