# Copy to .env in the REPOSITORY ROOT. Never commit a filled-in .env.
# The values below are throwaway local-only defaults that match infra/docker-compose.local.yml.
# They are deliberately not secrets. Never put a real credential in this file or in .env.
#
# The API reads .env from the repository root first, then services/api/.env if present.
# Both are resolved as absolute paths, so the working directory does not matter.

# --- services/api ---
ACADEMY_ENVIRONMENT=local
# Absolute, or relative to the repository root (never relative to the working directory).
ACADEMY_CONTENT_ROOT=packages/content
ACADEMY_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# --- database (required) ---
# Must use the asyncpg driver; a plain postgresql:// URL fails fast at startup.
ACADEMY_DATABASE_URL=postgresql+asyncpg://academy:academy_local_dev@127.0.0.1:5432/academy
ACADEMY_DATABASE_POOL_SIZE=5
ACADEMY_DATABASE_MAX_OVERFLOW=5
# Echo every statement to the log. Useful when debugging, far too noisy otherwise.
ACADEMY_DATABASE_ECHO=false

# --- cache (optional) ---
# Redis is a cache, never a source of truth. Leave ACADEMY_REDIS_URL empty to disable it:
# the API still starts and content still renders, with every read reported as a miss.
ACADEMY_REDIS_URL=redis://127.0.0.1:6379/0
# Set true only where a missing cache should be a startup error rather than degraded mode.
ACADEMY_CACHE_REQUIRED=false
ACADEMY_CACHE_DEFAULT_TTL_SECONDS=300

# --- erasure (optional, privileged) ---
# Shared secret for DELETE /internal/learners/{id}, the only route that may remove
# evidence. Leave this UNSET and the route is not registered at all, which is the correct
# posture for any environment that does not need to service an erasure request.
# When you do set it, generate a long random value and supply it through the deployment's
# secret store. Never write a real token into this file or into a committed .env.
# ACADEMY_ERASURE_TOKEN=

# --- tutoring (optional) ---
# Selects the default tutoring provider. Exactly one is registered: `deterministic-los`,
# a rule-based reader of the published Learning Object. It is not an LLM, and there is
# deliberately no external-provider setting, API key, or endpoint to configure here.
ACADEMY_TUTOR_PROVIDER=deterministic-los

# --- apps/web ---
# Next.js loads env files from apps/web, so copy this block to apps/web/.env for local dev.
ACADEMY_API_URL=http://127.0.0.1:8000
# The browser talks to the API directly for the learner loop, so this one is public by
# design. It must be reachable from the learner's machine, not just from the server.
NEXT_PUBLIC_ACADEMY_API_URL=http://127.0.0.1:8000
# Opt out of Next.js build/dev telemetry. Also enforced by apps/web/scripts/next.mjs.
NEXT_TELEMETRY_DISABLED=1
